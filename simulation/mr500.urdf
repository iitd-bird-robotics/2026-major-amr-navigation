<?xml version="1.0"?>
<robot name="mr500">

  <!-- BASE LINK - centered at wheel axis, origin on floor -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.165" rpy="0 0 0"/>
      <geometry>
        <box size="1.17 0.8 0.33"/>
      </geometry>
      <material name="yellow">
        <color rgba="0.2 0.2 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.165" rpy="0 0 0"/>
      <geometry>
        <box size="1.17 0.8 0.33"/>
      </geometry>
    </collision>
  </link>

  <!-- CAMERA LINKS -->
  <link name="camera_front_link">
    <visual>
      <geometry>
        <box size="0.1 0.05 0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <link name="camera_back_link">
    <visual>
      <geometry>
        <box size="0.1 0.05 0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <!-- LASER LINK (Velodyne C16) -->
  <link name="laser">
    <visual>
      <geometry>
        <cylinder length="0.1" radius="0.1"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <!-- SICK TiM320 Sensors (New) -->
  <link name="sick_front_right">
    <visual>
      <geometry>
        <box size="0.06 0.06 0.08"/>
      </geometry>
      <material name="green">
        <color rgba="0.0 0.8 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <link name="sick_back_left">
    <visual>
      <geometry>
        <box size="0.06 0.06 0.08"/>
      </geometry>
      <material name="green">
        <color rgba="0.0 0.8 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <!-- OTHER LINKS (minimal visual) -->
  <link name="r2300">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="yellow">
        <color rgba="0.8 0.8 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <link name="pgv_link">
    <visual>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>
      <material name="purple">
        <color rgba="0.6 0.1 0.6 1.0"/>
      </material>
    </visual>
  </link>

  <!-- ========== JOINTS ========== -->

  <!-- Velodyne Laser joint - UPDATED PER MEASUREMENT -->
  <joint name="base_link_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.305 0.0 1.5" rpy="0.0 0.0 3.14"/>
  </joint>

  <!-- Front camera joint - UPDATED PER MEASUREMENT -->
  <joint name="base_link_to_camera_front_link" type="fixed">
    <parent link="base_link"/>
    <child link="camera_front_link"/>
    <origin xyz="0.485 0.0 0.5" rpy="0.0 0.0 0.0"/>
  </joint>

  <!-- Sick Front-Right - NEW -->
  <joint name="base_link_to_sick_fr" type="fixed">
    <parent link="base_link"/>
    <child link="sick_front_right"/>
    <origin xyz="0.525 -0.34 0.165" rpy="0.0 0.0 -0.785"/> <!-- 45 deg out -->
  </joint>

  <!-- Sick Back-Left - NEW -->
  <joint name="base_link_to_sick_bl" type="fixed">
    <parent link="base_link"/>
    <child link="sick_back_left"/>
    <origin xyz="-0.53 0.40 0.165" rpy="0.0 0.0 2.356"/> <!-- 225 deg (opposite) -->
  </joint>

  <!-- Back camera joint -->
  <joint name="base_link_to_camera_back_link" type="fixed">
    <parent link="base_link"/>
    <child link="camera_back_link"/>
    <origin xyz="-0.06 0.02 0.513" rpy="0.0 0.0 3.14159"/>
  </joint>

  <!-- R2300 joint (Guessing position based on new model) -->
  <joint name="base_link_to_r2300" type="fixed">
    <parent link="base_link"/>
    <child link="r2300"/>
    <origin xyz="0.218 0.0 0.15" rpy="0.0 0.0 3.14"/>
  </joint>

  <!-- PGV100 joint -->
  <joint name="base_link_to_pgv" type="fixed">
    <parent link="base_link"/>
    <child link="pgv_link"/>
    <origin xyz="0.095 0.0 0.05" rpy="0.0 0.0 1.57079632679"/>
  </joint>

</robot>
